{
  "mcpServers": {
    "blackduck-bdsca-mcp": {
      "command": "uvx",
      "args": [
        "--managed-python",
        "--python",
        "3.13",
        "--from",
        "blackduck-sca-mcp==0.9.6",
        "bdsca"
      ],
      "env": {
        "BLACKDUCK_BDSCA_URL": "${BLACKDUCK_BDSCA_URL:-}",
        "BLACKDUCK_BDSCA_TOKEN": "${BLACKDUCK_BDSCA_TOKEN:-}"
      }
    }
  }
}
